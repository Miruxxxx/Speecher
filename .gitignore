# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Rust (нативный захват): собирается локально, бинарь в историю не кладём
native/*/target/

# Visual Studio / VS Code
.vs/
.vscode/

# Модели и артефакты
models/
*.gguf

# Локальные данные
storage/transcripts/*
!storage/transcripts/.gitkeep

# Логи
*.log

# Записи для ручных прогонов (probe.wav и т.п.) — большие бинарники,
# в историю их класть незачем: скрипты в scripts/ принимают любой путь
*.wav

# Claude Code (личные настройки, не коммитить)
.claude/settings.local.json

# API-ключи никогда не хранятся в дереве проекта (см. src/llm/credentials.py),
# но правило на месте на случай, если кто-то поменяет путь хранилища.
credentials.json
