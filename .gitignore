# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Rust (нативный захват): собирается локально, бинарь в историю не кладём
native/*/target/

# Visual Studio / VS Code
.vs/
.vscode/

# Модели и артефакты
models/
*.gguf

# Локальные данные
storage/transcripts/*
!storage/transcripts/.gitkeep
storage/logs/

# Логи
*.log

# Записи для ручных прогонов (probe.wav и т.п.) — большие бинарники,
# в историю их класть незачем: скрипты в scripts/ принимают любой путь
*.wav

# Claude Code (личные настройки, не коммитить)
.claude/settings.local.json

# Внутренние доки живут локально: инструкции агенту, спеки, ревью и хендоффы —
# это рабочие записи, а не документация проекта. В репозитории остаются README
# (что это и как запустить) и роадмап (куда идём). Файлы на диске никуда не
# делись — просто git их больше не отслеживает.
/CLAUDE.md
/docs/*
!/docs/ROADMAP.md

# API-ключи никогда не хранятся в дереве проекта (см. src/llm/credentials.py),
# но правило на месте на случай, если кто-то поменяет путь хранилища.
credentials.json
